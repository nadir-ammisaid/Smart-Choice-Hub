{
  "name": "p3",
  "version": "0.0.1",
  "description": "",
  "homepage": "https://github.com/wcs/p3#readme",
  "bugs": {
    "url": "https://github.com/wcs/p3/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcs/p3.git"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "biome check --error-on-warnings --no-errors-on-unmatched --staged . && npm run check-types --workspaces --if-present",
    "clean": "node ./bin/clean",
    "db:generate": "npm run db:generate --workspace=@js-monorepo/server",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=@js-monorepo/server",
    "db:migrate:baseline": "npm run db:migrate:baseline --workspace=@js-monorepo/server",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@js-monorepo/server",
    "db:studio": "npm run db:studio --workspace=@js-monorepo/server",
    "db:migrate:legacy": "npm run db:migrate:legacy --workspace=@js-monorepo/server",
    "db:seed": "npm run db:seed --workspace=@js-monorepo/server",
    "dev": "concurrently -c green,yellow -t \"HH:mm:ss\" -p \"{name} {time}\" \"npm:dev:*\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=@js-monorepo/server",
    "prepare": "node -e \"try { require('child_process').execSync('husky', {stdio: 'ignore'}) } catch (e) {}\"",
    "start": "npm run start --workspace=@js-monorepo/server",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [],
  "author": "wcs",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.2",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.6",
    "validate-branch-name": "^1.3.2"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "react-quill": "^2.0.0"
  }
}
