/* Mobile-first styles */

#page_container {
  background: linear-gradient(
      rgba(255, 255, 255, 0.5),
      rgba(255, 255, 255, 0.5)
    ), url("../assets/images/logo.png");
  background-size: cover;
  background-position: center;
  background-blend-mode: lighten;
  min-height: calc(100vh - 120px);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md);
}

#icon_container {
  text-align: right;
  width: 100%;
  margin-bottom: -1rem;
  position: relative;
  z-index: 2;
}

#input_upload {
  position: absolute;
  width: 2rem;
  height: 2rem;
  opacity: 0;
  cursor: pointer;
  z-index: 1;
}

#avatar {
  height: clamp(8rem, 25vw, 12rem);
  width: clamp(8rem, 25vw, 12rem);
  border-radius: var(--radius-full);
  object-fit: cover;
}

#champ_container {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-lg);
  width: 100%;
  max-width: var(--breakpoint-md);
}

#fieldsAndButtons {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.text_container {
  width: 100%;
  max-width: 350px;
  height: clamp(3.5rem, 10vw, 4rem);
  border-radius: var(--radius-sm);
  background: var(--color-secondary);
  box-shadow: var(--shadow-md);
  display: flex;
  justify-content: space-between;
  padding: 0 var(--spacing-md);
  align-items: center;
}

.text_container h3 {
  font-size: var(--font-size-base);
  color: var(--color-text);
}

.edit_icon_profile {
  width: clamp(1.5rem, 5vw, 2rem);
  height: clamp(1.5rem, 5vw, 2rem);
  cursor: pointer;
}

#edit_icon_profile_avatar {
  width: clamp(1.5rem, 5vw, 2rem);
  height: clamp(1.5rem, 5vw, 2rem);
  cursor: pointer;
}

.button_icon_profile {
  border: none;
  background: none;
  position: relative;
  padding: 0;
}

#password_recovery_container {
  margin-top: var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
}

#password_recovery_link {
  font-size: var(--font-size-lg);
  text-align: center;
  font-weight: bold;
  text-decoration: underline;
  color: var(--color-primary);
  transition: color 0.3s ease;
}

#password_recovery_link:hover {
  color: lighten(var(--color-primary), 20%);
}

#delete-button {
  display: flex;
  width: clamp(8rem, 25vw, 9.5rem);
  height: clamp(2.5rem, 8vw, 3.1rem);
  font-size: var(--font-size-base);
  font-weight: bold;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-xs);
  border-radius: var(--radius-sm);
  background: var(--color-accent-red);
  color: var(--color-secondary);
  text-decoration: none;
  cursor: pointer;
  margin: var(--spacing-sm);
  transition: background-color 0.3s ease, transform 0.3s ease;
  border: none;
}

#delete-button:hover {
  background-color: darken(var(--color-accent-red), 10%);
  transform: translateY(-2px);
}

#delete-button-yes,
#delete-button-cancel {
  display: flex;
  width: clamp(8rem, 25vw, 9.5rem);
  height: clamp(2.5rem, 8vw, 3.1rem);
  font-size: var(--font-size-base);
  font-weight: bold;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-xs);
  border-radius: var(--radius-sm);
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.3s ease, transform 0.3s ease;
  border: none;
}

#delete-button-yes {
  background: var(--color-accent-red);
  color: var(--color-secondary);
}

#delete-button-yes:hover {
  background-color: darken(var(--color-accent-red), 10%);
  transform: translateY(-2px);
}

#delete-button-cancel {
  background: var(--color-primary);
  color: var(--color-secondary);
}

#delete-button-cancel:hover {
  background-color: lighten(var(--color-primary), 10%);
  transform: translateY(-2px);
}

#button_icon-update-my-avatar {
  display: flex;
  width: clamp(8rem, 25vw, 9.5rem);
  height: clamp(2.5rem, 8vw, 3.1rem);
  font-size: var(--font-size-base);
  font-weight: bold;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-xs);
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: var(--color-secondary);
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.3s ease, transform 0.3s ease;
  border: none;
}

#button_icon-update-my-avatar:hover {
  background-color: lighten(var(--color-primary), 10%);
  transform: translateY(-2px);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--color-modal-bg);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  font-weight: bold;
  z-index: 1000;
}

.modal-content {
  background: var(--color-bg);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  max-width: 500px;
  width: 80%;
  min-width: 250px;
  box-shadow: var(--shadow-md);
}

#avatar_icon_container {
  position: relative;
}

#avatar_container {
  position: relative;
  z-index: 1;
}

#boutonConfirmAvatar {
  display: flex;
  justify-content: center;
  margin-top: var(--spacing-sm);
  gap: var(--spacing-sm);
}

/* Tablet and larger */
@media (min-width: 768px) {
  #page_container {
    padding: var(--spacing-xl);
  }

  #mainProfile {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: var(--spacing-xl);
    width: 100%;
    max-width: var(--breakpoint-lg);
  }

  #champ_container {
    gap: var(--spacing-lg);
    margin-top: 0;
  }

  .text_container {
    width: 26rem;
    height: 5rem;
  }

  .text_container h3 {
    font-size: var(--font-size-lg);
  }

  #avatar {
    height: 15rem;
    width: 15rem;
  }

  #edit_icon_profile_avatar,
  .edit_icon_profile {
    width: clamp(2.5rem, 5vw, 3rem);
    height: clamp(2.5rem, 5vw, 3rem);
  }

  #icon_container {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    width: auto;
    margin-bottom: 0;
  }

  #password_recovery_link {
    font-size: var(--font-size-xl);
  }
}
