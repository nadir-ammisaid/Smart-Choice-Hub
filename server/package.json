{
  "name": "@js-monorepo/server",
  "scripts": {
    "check-types": "node ./node_modules/typescript/bin/tsc --noEmit",
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch --clear-screen=false ./src/main",
    "db:generate": "node ./bin/prisma.js generate",
    "db:migrate:dev": "node ./bin/prisma.js migrate dev",
    "db:migrate:baseline": "node ./bin/prisma.js migrate resolve --applied 20260503183000_init",
    "db:migrate:deploy": "node ./bin/prisma.js migrate deploy",
    "db:push": "node ./bin/prisma.js db push",
    "db:studio": "node ./bin/prisma.js studio",
    "db:migrate:legacy": "node ./bin/migrate.js",
    "db:seed": "node ../node_modules/tsx/dist/cli.mjs ./bin/seed",
    "build": "npm run db:generate && node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "NODE_PATH=./node_modules node ../dist/src/main.js",
    "test": "node ../node_modules/jest/bin/jest.js --verbose"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.5.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.4.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
